DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-1-us-west-1.pooler.supabase.com
DB_NAME=postgres

SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: comma-separated list or JSON array. Defaults include localhost:5173 and localhost:3000.
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Alphapay - fill in once credentials are received.
ALPHAPAY_PARTNER_CODE=YOUR_PARTNER_CODE
# Local dev: point to the PEM file.
ALPHAPAY_PRIVATE_KEY_PATH=/path/to/alphapay_private.pem
# Production: paste PEM content with \n for newlines.
# ALPHAPAY_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
WEBHOOK_BASE_URL=https://your-domain.com

# Stripe - fill in your keys from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
