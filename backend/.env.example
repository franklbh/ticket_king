DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-1-us-west-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_AUTH_USERS_TABLE=auth.users

# Admin API table names. These can point to tables or read views.
ADMIN_ORDERS_TABLE=orders
ADMIN_TICKETS_TABLE=tickets
ADMIN_SLOTS_TABLE=slots
ADMIN_TICKET_TYPES_TABLE=ticket_types
ADMIN_AUDIT_LOGS_TABLE=audit_logs
ADMIN_USERS_TABLE=users
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORDER_ID_COLUMN=order_id
ADMIN_TICKET_ID_COLUMN=ticket_id
ADMIN_TICKET_STATUS_COLUMN=ticket_status

# Optional: comma-separated list. Defaults include customer/admin dev ports.
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000

# Alphapay - fill in once credentials are received.
ALPHAPAY_PARTNER_CODE=YOUR_PARTNER_CODE
# Local dev: point to the PEM file.
ALPHAPAY_PRIVATE_KEY_PATH=/path/to/alphapay_private.pem
# Production: paste PEM content with \n for newlines.
# ALPHAPAY_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
WEBHOOK_BASE_URL=https://your-domain.com

# Stripe - fill in your keys from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
