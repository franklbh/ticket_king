APP_NAME=Ticket King Admin API
APP_ENV=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Postgres direct connection.
# These names intentionally match the current backend .env style.
user=
password=
host=
port=5432
dbname=postgres

# Optional alternative. If set, this overrides the fields above.
DATABASE_URL=

# Defaults assume admin tables or views with these names.
ADMIN_ORDERS_TABLE=orders
ADMIN_TICKETS_TABLE=tickets
ADMIN_SLOTS_TABLE=slots
ADMIN_TICKET_TYPES_TABLE=ticket_types
ADMIN_AUDIT_LOGS_TABLE=audit_logs
ADMIN_USERS_TABLE=users
SUPABASE_AUTH_USERS_TABLE=auth.users
ADMIN_BOOTSTRAP_TOKEN=

# Change these if your existing Supabase table uses different primary columns.
ADMIN_ORDER_ID_COLUMN=order_id
ADMIN_TICKET_ID_COLUMN=ticket_id
ADMIN_TICKET_STATUS_COLUMN=ticket_status
